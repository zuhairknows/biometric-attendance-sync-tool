# ERPNext Connection
# ============================================================

# API credentials for the dedicated ERPNext integration user.
# Keep these credentials only in the local_config.py file.
ERPNEXT_API_KEY = 'YOUR_REAL_API_KEY'
ERPNEXT_API_SECRET = 'YOUR_REAL_API_SECRET'

# Production ERPNext site.
ERPNEXT_URL = 'https://erp.myfpf.com'

# ERPNext / HRMS major version.
ERPNEXT_VERSION = 15


# ============================================================
# Synchronization Settings
# ============================================================

# Poll biometric devices every 5 minutes.
PULL_FREQUENCY = 5

# IMPORTANT FOR WINDOWS SERVICE:
# In local_config.py, use an absolute path on the production PC, for example:
# LOGS_DIRECTORY = r'C:\\GitHub\\biometric-attendance-sync-tool\\logs'
#
# The template keeps a relative path so the repository remains portable.
LOGS_DIRECTORY = 'logs'

# Production go-live date.
# Any biometric punches before this date will not be imported.
# Format: YYYYMMDD
IMPORT_START_DATE = '20260910'

# Maximum number of seconds to wait for an ERPNext API response.
ERPNEXT_REQUEST_TIMEOUT = 30


