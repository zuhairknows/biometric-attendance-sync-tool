# ============================================================
# ERPNext Connection
# ============================================================

# API credentials for the dedicated ERPNext integration user.
# Replace the placeholders with the real credentials for your
# ERPNext site, and keep them only in this local file.
# The live configuration file (local_config.py) is not tracked
# by Git and must never be committed or shared.
ERPNEXT_API_KEY = 'YOUR_API_KEY'
ERPNEXT_API_SECRET = 'YOUR_API_SECRET'

# Web address of your ERPNext site.
ERPNEXT_URL = 'https://erp.example.com'

# ERPNext / HRMS major version.
ERPNEXT_VERSION = 15


# ============================================================
# Synchronization Settings
# ============================================================

# Poll biometric devices every 5 minutes.
# This is a good starting interval for production attendance.
PULL_FREQUENCY = 5

# Local directory used for application logs, device status,
# synchronization checkpoints, and retry dumps.
LOGS_DIRECTORY = 'logs'

# Replace this with the actual production go-live date.
# Any biometric punches before this date will not be imported.
# Format must remain a STRING in YYYYMMDD format.
IMPORT_START_DATE = 'YYYYMMDD'

# Maximum number of seconds to wait for an ERPNext API response.
ERPNEXT_REQUEST_TIMEOUT = 30


# ============================================================
# ZKTeco Biometric Devices
# ============================================================

devices = [
    {
        # Permanent device identity.
        # Do not change this when the device IP or port changes.
        'device_id': 'DEVICE_01',

        # Device IP address or hostname on your network.
        'ip': '192.0.2.10',

        # ZKTeco TCP port. 4370 is the common default on ZKTeco
        # devices, but use the port actually configured on yours.
        'port': 4370,

        # ZKTeco communication password.
        # 0 means no connection password.
        'password': 0,

        # Leave as None to let ERPNext Auto Attendance determine
        # IN/OUT from the employee's assigned Shift Type.
        # Allowed values: 'IN', 'OUT', 'AUTO', or None.
        'punch_direction': None,

        # IMPORTANT:
        # Never automatically delete punches from the device.
        # Keep this False in production.
        'clear_from_device_on_fetch': False
    }
]


# ============================================================
# ERPNext Shift Type Synchronization
# ============================================================

# Map the biometric devices to the ERPNext Shift Types whose
# employees use them.
#
# - 'shift_type_name' entries must exactly match the Shift Type
#   names configured in your ERPNext site.
# - 'related_device_id' entries must match the 'device_id' values
#   defined in the devices list above.
# - One device may be related to multiple Shift Types when
#   employees on different shifts use the same device.
#
# last_sync_of_checkin will advance only after the related
# biometric device has been processed successfully.

shift_type_device_mapping = [
    {
        'shift_type_name': [
            'Morning Shift',
            'Night Shift'
        ],
        'related_device_id': [
            'DEVICE_01'
        ]
    }
]


# ============================================================
# Allowed ERPNext Exceptions
# ============================================================

# These known conditions must not stop synchronization of
# subsequent biometric punches:
#
# 1 = No Employee found for Attendance Device ID
# 2 = Employee is inactive
# 3 = Duplicate Employee Checkin

allowed_exceptions = [1, 2, 3]
