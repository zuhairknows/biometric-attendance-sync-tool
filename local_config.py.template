# ERPNext Connection
# ============================================================

# API credentials for the dedicated ERPNext integration user.
# Keep these credentials only in the local_config.py file.
ERPNEXT_API_KEY = 'YOUR_REAL_API_KEY'
ERPNEXT_API_SECRET = 'YOUR_REAL_API_SECRET'

# Production ERPNext site.
ERPNEXT_URL = 'https://erp.myfpf.com'

# ERPNext / HRMS major version.
ERPNEXT_VERSION = 15


# ============================================================
# Synchronization Settings
# ============================================================

# Poll biometric devices every 5 minutes.
PULL_FREQUENCY = 5

# IMPORTANT FOR WINDOWS SERVICE:
# In local_config.py, use an absolute path on the production PC, for example:
# LOGS_DIRECTORY = r'C:\\GitHub\\biometric-attendance-sync-tool\\logs'
#
# The template keeps a relative path so the repository remains portable.
LOGS_DIRECTORY = 'logs'

# Production go-live date.
# Any biometric punches before this date will not be imported.
# Format: YYYYMMDD
IMPORT_START_DATE = '20260910'

# Maximum number of seconds to wait for an ERPNext API response.
ERPNEXT_REQUEST_TIMEOUT = 30

# Phase 1 is opt-in: follow docs/phase1-durable-sync.md before enabling.
# Never use a path in the Git checkout. Provision service-account-only NTFS access.
DURABLE_SYNC_ENABLED = False
DURABLE_DB_PATH = r'C:\ProgramData\ERPNextBiometricPushService\sync.sqlite3'
DURABLE_BATCH_SIZE = 100
DURABLE_REQUESTS_PER_SECOND = 2
DURABLE_RETRY_BASE_SECONDS = 30
DURABLE_RETRY_MAX_SECONDS = 3600
DURABLE_AUTH_COOLDOWN_SECONDS = 900
# Must exceed 2 * request timeout + 30 seconds, to recover interrupted sends safely.
DURABLE_LEASE_SECONDS = 120

# Uncertain sends (timeout, 5xx) are never POSTed blindly again. With confirmation
# reads enabled, the service looks the punch up in ERPNext (Employee by device ID,
# then Employee Checkin within +/-2 seconds). Present -> recorded as delivered.
# With DURABLE_RESEND_VERIFIED_MISSING it is sent once more only when both reads
# succeed and prove it absent, and the last attempt is older than
# DURABLE_RESEND_SETTLE_SECONDS (a timed-out POST may still be committing).
# The API user needs read access to Employee and Employee Checkin.
DURABLE_CONFIRM_READS_VERIFIED = False
DURABLE_SERVER_REVIEW_REFERENCE = ''
DURABLE_RESEND_VERIFIED_MISSING = False
DURABLE_RESEND_SETTLE_SECONDS = 600
# A card enrolled on a device before its Employee existed gets "No Employee found".
# Each such card is looked up again (one Employee read, at most every
# UNMATCHED_RECHECK_HOURS); once the Employee exists and is Active, its punches dated in
# the last UNMATCHED_RECHECK_DAYS are sent again. 0 days turns this off. Needs the
# confirmation reads above.
UNMATCHED_RECHECK_DAYS = 30
UNMATCHED_RECHECK_HOURS = 6


# ============================================================
# Station Terminals (optional)
# ============================================================
#
# Only for a terminal with a screen beside it that has to react to a punch -
# an operator confirming production at a machine, for example. Leave
# STATION_PUNCH_METHOD empty and every device's 'realtime' False, and none of
# this does anything: no port is opened and nothing is posted, so attendance
# sync behaves exactly as before.
#
# This path never creates the Employee Checkin. The ordinary poll still does
# that, which is also what keeps attendance correct whenever the push path is
# down.

# The whitelisted ERPNext method a realtime punch is posted to, for example
# 'advanced_manufacturing.station.punch'. Empty disables the push entirely.
STATION_PUNCH_METHOD = ''

# Seconds to wait for that method. Deliberately much shorter than
# ERPNEXT_REQUEST_TIMEOUT: somebody is standing at the machine, and a reply
# that arrives late is of no use to them. A station punch is never retried.
STATION_PUNCH_TIMEOUT = 5

# A station punch timed further than this many seconds from the sync PC's
# clock is acknowledged but not posted. A terminal newly switched to ADMS may
# upload its stored punches, and those must not each trigger a label. Keep the
# terminal clocks right; a terminal more than this far out is ignored.
STATION_PUNCH_MAX_AGE_SECONDS = 300

# Which configured devices are station terminals, as device_id -> serial
# number (System Info on the terminal). The same as adding
# 'realtime': True and 'serial_number' to those entries in devices below, but
# one line, which is what deployment/Install-StationTerminal.ps1 writes.
# A device_id that is not in devices is a station-only terminal: recognised by
# its serial, never polled, so its punches are not attendance.
STATION_DEVICES = {}

# Where the ADMS listener binds. The terminals must be able to reach it, so
# this is 0.0.0.0 rather than loopback - restrict it to the device VLAN at the
# firewall. The port only opens when some device has 'realtime': True.
STATION_LISTENER_HOST = '0.0.0.0'
STATION_LISTENER_PORT = 8090


