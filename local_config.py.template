# ============================================================
# Allowed ERPNext Exceptions
# ============================================================
#
# These known conditions must not stop synchronization of
# subsequent biometric punches:
#
# 1 = No Employee found for Attendance Device ID
# 2 = Employee is inactive
# 3 = Duplicate Employee Checkin
#
# Duplicate Employee Checkins are additionally handled by the
# customized integration as idempotent/already synchronized.

allowed_exceptions = [1, 2, 3]