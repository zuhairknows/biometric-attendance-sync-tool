# Synthetic evidence hashes are over exact bytes, including original line endings.
examples/reconciliation/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
examples/reconciliation/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol

